@baseUrl = http://localhost:4000

###############################################################
# BASICS
###############################################################

### Health -> 200 with api, database and redis all "ok"
GET {{baseUrl}}/health

### Departments -> 200, four departments (Finance 1, Legal 2, HR 3, Engineering 4)
GET {{baseUrl}}/api/departments


###############################################################
# AUTH
###############################################################

### Login as admin -> 200 { user, token }
# @name admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@company.com", "password": "Password123!" }

### Current user -> 200
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{admin.response.body.token}}

### Register a new user -> 201 on the first run, 409 on every run after that
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "name": "Test User", "email": "testtest@company.com", "password": "Password123!", "departmentId": 1 }

### Register with a weak password -> 400 with per-field details
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "name": "Test User", "email": "weak2@company.com", "password": "abc", "departmentId": 1 }

### Register with an unknown department -> 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "name": "Test User", "email": "dept@company.com", "password": "Password123!", "departmentId": 999 }

### Register sending a role -> 201, but the user is still an "employee"
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "name": "Sneaky", "email": "sneaky@company.com", "password": "Password123!", "departmentId": 1, "role": "admin" }

### Login with a wrong password -> 401 "Invalid email or password"
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@company.com", "password": "WrongPass1" }

### Current user with no token -> 401
GET {{baseUrl}}/api/auth/me

### Current user with a tampered token -> 401
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{admin.response.body.token}}x


###############################################################
# LOGINS FOR THE DEMO USERS (send these before the document requests)
###############################################################

### Omar, Finance employee (id 1)
# @name omar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "finance.employee@company.com", "password": "Password123!" }

