# @name farida
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "finance.manager@company.com", "password": "Password123!" }

### Laila, Legal manager (id 2)
# @name laila
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "legal.manager@company.com", "password": "Password123!" }

### Hana, HR employee (id 3)
# @name hana
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "hr.employee@company.com", "password": "Password123!" }

### Ziad, Engineering employee (id 4)
# @name ziad
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "engineer@company.com", "password": "Password123!" }


###############################################################
# DOCUMENT UPLOAD
###############################################################

### Upload a restricted document as Omar, shared with Legal -> 201
### allowedDepartmentIds should be [1, 2] (Legal plus Omar's own Finance)
# @name upload
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Annual Finance Report
------FormBoundary
Content-Disposition: form-data; name="description"

Audited figures for the year
------FormBoundary
Content-Disposition: form-data; name="tags"

Finance, Report
------FormBoundary
Content-Disposition: form-data; name="visibility"

restricted
------FormBoundary
Content-Disposition: form-data; name="departmentIds"

2
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--

### Upload with no token -> 401
POST {{baseUrl}}/api/documents
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

No token
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--

### Upload with a missing title -> 400 with details
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="tags"

Finance
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--

### Upload with no file part -> 400
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

No file attached
------FormBoundary--

### Upload a disallowed file type (.exe) -> 415
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Not allowed
------FormBoundary
Content-Disposition: form-data; name="file"; filename="malware.exe"
Content-Type: application/octet-stream

< ./samples/malware.exe
------FormBoundary--

### Upload text renamed to .pdf (content does not match) -> 415
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Fake PDF
------FormBoundary
Content-Disposition: form-data; name="file"; filename="fake.pdf"
Content-Type: application/pdf

< ./samples/fake.pdf
------FormBoundary--

### Public document with departmentIds -> 400
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Public but with departments
------FormBoundary
Content-Disposition: form-data; name="visibility"

public
------FormBoundary
Content-Disposition: form-data; name="departmentIds"

2
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--

### Restricted to a department that does not exist -> 400
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Unknown department
------FormBoundary
Content-Disposition: form-data; name="visibility"

restricted
------FormBoundary
Content-Disposition: form-data; name="departmentIds"

999
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--

### Eleven tags -> 400 ("At most 10 tags")
POST {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

Too many tags
------FormBoundary
Content-Disposition: form-data; name="tags"

t1,t2,t3,t4,t5,t6,t7,t8,t9,t10,t11
------FormBoundary
Content-Disposition: form-data; name="file"; filename="report.pdf"
Content-Type: application/pdf

< ./samples/report.pdf
------FormBoundary--


###############################################################
# DOCUMENT DETAIL AND PERMISSIONS
# (send the "upload" request above first; its id is reused below)
###############################################################

### As Omar, the uploader -> 200
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{omar.response.body.token}}

### As Farida, same department (Finance) -> 200
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{farida.response.body.token}}

### As Laila, Legal (listed department) -> 200
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{laila.response.body.token}}

### As admin -> 200
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{admin.response.body.token}}

### As Hana, HR (not listed) -> 403
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{hana.response.body.token}}

### As Ziad, Engineering (not listed) -> 403
GET {{baseUrl}}/api/documents/{{upload.response.body.document.id}}
Authorization: Bearer {{ziad.response.body.token}}

### A valid but unknown id -> 404
GET {{baseUrl}}/api/documents/3f2a8c1e-5b4d-4e6f-9a7b-1c2d3e4f5a6b
Authorization: Bearer {{omar.response.body.token}}

### A malformed id -> 400
GET {{baseUrl}}/api/documents/abc
Authorization: Bearer {{omar.response.body.token}}

###############################################################
# SEARCH (run `npm run seed:documents` first)
###############################################################

### Everything Omar can see (Finance) -> total 4
GET {{baseUrl}}/api/documents
Authorization: Bearer {{omar.response.body.token}}

### Same list as Hana (HR) -> total 2 (restricted Finance and Legal documents are hidden)
GET {{baseUrl}}/api/documents
Authorization: Bearer {{hana.response.body.token}}

### Full-text with highlight -> "Leave Policy"; title_highlight contains [[Leave]]
GET {{baseUrl}}/api/documents?q=leave
Authorization: Bearer {{omar.response.body.token}}

### Typo tolerance -> still finds "Annual Finance Report"
GET {{baseUrl}}/api/documents?q=finnance
Authorization: Bearer {{omar.response.body.token}}

### Partial word -> "Employee Leave Policy"
GET {{baseUrl}}/api/documents?q=polic
Authorization: Bearer {{omar.response.body.token}}

### A search can never leak: Hana searching "finance" -> 0 results
GET {{baseUrl}}/api/documents?q=finance
Authorization: Bearer {{hana.response.body.token}}

### Tag filter -> 1 result (Finance report)
GET {{baseUrl}}/api/documents?tags=finance
Authorization: Bearer {{omar.response.body.token}}

### Tags, any-mode -> HR policy and technical guide (2)
GET {{baseUrl}}/api/documents?tags=hr,technical&tagMode=any
Authorization: Bearer {{omar.response.body.token}}

### Tags, all-mode -> 0 (no document has both)
GET {{baseUrl}}/api/documents?tags=hr,technical&tagMode=all
Authorization: Bearer {{omar.response.body.token}}

### By uploader name -> "Employee Leave Policy"
GET {{baseUrl}}/api/documents?uploader=hana
Authorization: Bearer {{omar.response.body.token}}

### File type -> all PDFs (4)
GET {{baseUrl}}/api/documents?fileType=pdf
Authorization: Bearer {{omar.response.body.token}}

### Sort by title, page 2 of size 2 -> "Employee Leave Policy", "Vendor Contract Template"
GET {{baseUrl}}/api/documents?sort=title&limit=2&page=2
Authorization: Bearer {{omar.response.body.token}}

### Date range (use today's date)
GET {{baseUrl}}/api/documents?from=2026-10-01&to=2026-12-31
Authorization: Bearer {{omar.response.body.token}}

### Tag autocomplete -> ["Finance"]
GET {{baseUrl}}/api/tags?q=fi
Authorization: Bearer {{omar.response.body.token}}

### Validation -> 400 each
GET {{baseUrl}}/api/documents?limit=1000
Authorization: Bearer {{omar.response.body.token}}

###
GET {{baseUrl}}/api/documents?sort=banana
Authorization: Bearer {{omar.response.body.token}}

###
GET {{baseUrl}}/api/documents?page=0
Authorization: Bearer {{omar.response.body.token}}

### No token -> 401
GET {{baseUrl}}/api/documents